// PRD Audit state machine.
//
// Source of truth for the /audit-prd skill's flow. The walker (Claude, per
// SKILL.md) reads each node's prose from nodes/<id>.md, performs the work,
// evaluates the outgoing edges' conditions against the current state
// (primarily MANIFEST.json + artifact files), and transitions. The
// structural enforcement points are lib/prd-runner.sh (which owns $AUDIT_DIR
// creation and PRD fetch), lib/audit-codex.sh (which proves the parallel
// codex review ran), and lib/audit-verify.sh (which gates the handoff edge).
//
// This is the canonical audit-* graph, unchanged in topology. The unit of
// audit is a *document* rather than a code tree: orient fetches/normalizes
// the PRD instead of running security tooling, and emergency_exit fires when
// the source is not a reviewable PRD (empty / too thin) rather than on a live
// credential. The graph stays uniform with the rest of the family.
//
// Render to SVG with scripts/render.sh. Validate with scripts/validate.py.

digraph audit_prd {
    rankdir=TB;
    bgcolor="white";
    node  [fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=9];

    // -- Process nodes (rounded boxes, light blue) ----------------------
    init                [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="init\n(parse args, resolve PRD source,\nrun prd-runner.sh init)"];
    orient              [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="orient\n(fetch + normalize PRD,\nsection map, reviewability gate)"];
    independent_reviews [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="independent-reviews\n(Phase 2: review sub-agent writes claude.md,\ncodex exec writes codex.md, parallel)"];
    synthesis           [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="synthesis\n(Phase 3: dedupe, calibrate,\ncontradiction clusters, synthesis.md)"];
    devils_advocate     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="devils-advocate\n(Phase 4: codex attacks,\nincorporate challenges)"];
    report              [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="report\n(Phase 5: write REPORT.md\nwith readiness verdict + tiers)"];
    emergency_exit      [shape=box, style="rounded,filled", fillcolor="#ffcdd2",
                         label="emergency-exit\n(not a reviewable PRD —\nwrite EMERGENCY.md, halt)"];
    handoff             [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                         label="handoff\n(print hand-off with verify output;\nread-only — no writes to source)"];

    // -- Decision nodes (diamonds) -------------------------------------
    verify              [shape=diamond, style=filled, fillcolor="#ffe0b2",
                         label="verify\n(audit-verify.sh —\nartifacts gate)"];

    // -- User-input nodes (coral diamonds) -----------------------------
    escalate            [shape=diamond, style=filled, fillcolor="#ffccbc",
                         label="escalate\n(verify failed —\nask user)"];

    // -- Terminal (green double-circle) --------------------------------
    terminal            [shape=doublecircle, style=filled, fillcolor="#c8e6c9",
                         label="terminal"];

    // -- Edges ---------------------------------------------------------
    init                -> orient;
    orient              -> independent_reviews [label="proceed"];
    orient              -> emergency_exit      [label="emergency"];
    emergency_exit      -> terminal;
    independent_reviews -> synthesis;
    synthesis           -> devils_advocate;
    devils_advocate     -> report;
    report              -> verify;
    verify              -> handoff             [label="ok"];
    verify              -> escalate            [label="incomplete"];
    escalate            -> terminal            [label="user_acknowledge"];
    handoff             -> terminal;
}
