// Sprint Plan to Issues state machine.
//
// Source of truth for the /sprint-plan-to-issues skill. Takes an
// EXISTING sprint MILESTONE (created by /sprint-plan, whose description
// IS the SPRINT document), reads the plan out of the milestone, and
// decomposes it into one issue per task, attached to that milestone, with
// native Forgejo relationships (dependencies + cross-references). The
// walker (Claude, per SKILL.md) reads each node's prose from
// nodes/<id>.md, performs the work, evaluates the outgoing edges'
// conditions, and transitions via scripts/walk.sh.
//
// This skill does NOT create the milestone (sprint-plan does). It only
// adds issues to the milestone the plan already lives in.
//
// Render to SVG with scripts/render.sh. Validate with scripts/validate.py.

digraph sprint_plan_to_issues {
    rankdir=TB;
    bgcolor="white";
    node  [fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=9];

    // -- Process nodes (rounded boxes, light blue) ----------------------
    init             [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="init\n(resolve the milestone:\nURL or sprint query)"];
    parse_sprint     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="parse-milestone\n(read the SPRINT doc from the\nmilestone description; resolve repo)"];
    fetch_repo       [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="fetch-repo\n(tea labels list —\norientation)"];
    build_plan       [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="build-plan\n(one issue per plan task\n+ derive relationships)"];
    show_plan        [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="show-plan\n(render proposed issues inline)"];
    discuss_plan     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="discuss-plan\n(iterate on issues,\nback to ask-approval)"];
    create_issues    [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="create-issues\n(tea issues create --milestone\n+assignee; wire dependencies)"];
    finalize         [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                      label="finalize\n(write FORGEJO.md + summary)"];

    // -- User-input node (escalate-shaped diamond) ---------------------
    ask_approval     [shape=diamond, style=filled, fillcolor="#ffccbc",
                      label="ask-approval\n(approve / discuss / cancel)"];

    // -- Terminal node (green double-circle) ---------------------------
    terminal         [shape=doublecircle, style=filled, fillcolor="#c8e6c9",
                      label="terminal"];

    // -- Edges ---------------------------------------------------------
    // Single-outgoing edges (no condition needed).
    init             -> parse_sprint;
    parse_sprint     -> fetch_repo;
    fetch_repo       -> build_plan;
    build_plan       -> show_plan;
    show_plan        -> ask_approval;
    create_issues    -> finalize;
    finalize         -> terminal;

    // ask-approval: approve / discuss / cancel. On approve, create the
    // issues directly on the existing milestone (no milestone creation).
    ask_approval -> create_issues [label="user_approve"];
    ask_approval -> discuss_plan  [label="user_discuss"];
    ask_approval -> terminal      [label="user_cancel"];

    // discuss-plan: iterate on the plan, then back to ask-approval.
    discuss_plan -> ask_approval [label="discussion_done"];
}
