// Project Manage PRD state machine.
//
// Source of truth for the /project-manage-prd skill. A guided, Socratic
// discussion that walks the user through authoring (or revising) a Product
// Requirements Document, then publishes it to the repo's Forgejo wiki as the
// `PRD` page. The walker (Claude, per SKILL.md) reads each node's prose from
// nodes/<id>.md, performs the work, evaluates the outgoing edges' conditions,
// and transitions via scripts/walk.sh.
//
// Modeled on /sprint-seed (same guided-discussion backbone), but the durable
// output is the wiki PRD, and orient auto-detects create-vs-revise mode.
//
// Render to SVG with scripts/render.sh. Validate with scripts/validate.py.

digraph project_manage_prd {
    rankdir=TB;
    bgcolor="white";
    node  [fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=9];

    // -- Process nodes (rounded boxes, light blue) ----------------------
    init        [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="init\n(resolve repo, paths,\ninit walker state)"];
    orient      [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="orient\n(repo context + fetch existing\nPRD; set create/revise mode)"];
    kickoff     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="kickoff\n(mode-specific opening:\nauthor or revise)"];
    discuss     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="discuss\n(walk PRD sections Socratically,\none at a time, push back)"];
    draft       [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="draft\n(assemble the PRD,\nrender it inline)"];
    publish     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="publish\n(create/update the PRD\nwiki page)"];
    handoff     [shape=box, style="rounded,filled", fillcolor="#e1f5fe",
                 label="handoff\n(print wiki URL + next steps)"];

    // -- User-input nodes (escalate-shaped diamonds) ------------------
    ask_wrap_up [shape=diamond, style=filled, fillcolor="#ffccbc",
                 label="ask-wrap-up\n(more sections / draft it / cancel)"];
    ask_publish [shape=diamond, style=filled, fillcolor="#ffccbc",
                 label="ask-publish\n(publish / revise more / cancel)"];

    // -- Terminal node (green double-circle) ---------------------------
    terminal    [shape=doublecircle, style=filled, fillcolor="#c8e6c9",
                 label="terminal"];

    // -- Edges ---------------------------------------------------------
    // Single-outgoing edges (no condition needed).
    init    -> orient;
    orient  -> kickoff;
    kickoff -> discuss;
    draft   -> ask_publish;
    publish -> handoff;
    handoff -> terminal;

    // discuss: agent senses (or user signals) the sections are covered; or cancel.
    discuss -> ask_wrap_up [label="wrap_up_signaled"];
    discuss -> terminal    [label="user_cancel"];

    // ask-wrap-up: keep eliciting, assemble the draft, or bail.
    ask_wrap_up -> draft    [label="user_wrap_up"];
    ask_wrap_up -> discuss  [label="user_continue"];
    ask_wrap_up -> terminal [label="user_cancel"];

    // ask-publish: write it to the wiki, loop back to refine, or bail.
    ask_publish -> publish [label="user_publish"];
    ask_publish -> discuss [label="user_revise"];
    ask_publish -> terminal [label="user_cancel"];
}
